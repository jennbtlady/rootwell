# Copy to .env.local inside apps/web and to .env inside packages/db for local work.
# Never commit real values. Values from `supabase start` are safe to paste locally.

# Supabase (public, safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (server only)
SUPABASE_SECRET_KEY=
# Direct Postgres connection used by Drizzle. Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
# Optional. Only for projects still issuing HS256 tokens with the legacy shared JWT secret.
# Local Supabase and new projects sign with ES256 and the API verifies through the JWKS endpoint.
SUPABASE_JWT_SECRET=

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STANDARD=

# Resend
RESEND_API_KEY=
EMAIL_FROM="Maple Ledger <no-reply@example.com>"

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local development only. "off" lets owners and admins work without two-step sign-in.
# Ignored in production builds.
MFA_ENFORCEMENT=on
